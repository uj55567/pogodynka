{% extends 'base.html.twig' %}

{% block title %}Weather index{% endblock %}

{% block body %}
    <h1>Weather index</h1>

    <table class="table">
        <thead>
        <tr>
            <th>Id</th>
            <th>Date_time</th>
            <th>Temperature</th>
            <th>Humidity</th>
            <th>Pressure</th>
            <th>Index_uv</th>
            <th>actions</th>
        </tr>
        </thead>
        <tbody>
        {% for weather in weathers %}
            <tr>
                <td>{{ weather.id }}</td>
                <td>{{ weather.dateTime ? weather.dateTime|date('Y-m-d') : '' }}</td>
                <td>{{ weather.temperature }}</td>
                <td>{{ weather.humidity }}</td>
                <td>{{ weather.pressure }}</td>
                <td>{{ weather.indexUv }}</td>
                <td>
                    <a href="{{ path('app_weather_show', {'id': weather.id}) }}">show</a>
                    <a href="{{ path('app_weather_edit', {'id': weather.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_weather_new') }}">Create new</a>
{% endblock %}
